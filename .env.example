# Yuanshen AI 配置
# 1. cp .env.example .env
# 2. 填入你所使用模型对应的 API Key

# 默认模型，可选：
#   deepseek-v4-pro | deepseek-v4-flash | kimi-k3 | kimi-k2.7
MODEL=deepseek-v4-pro

# DeepSeek 模型使用（platform.deepseek.com → API Keys）
DEEPSEEK_API_KEY=sk-xxx

# Kimi 模型使用（platform.moonshot.cn → API Key）
MOONSHOT_API_KEY=sk-xxx

# 音频验收模式：auto | required | off
AUDIO_VALIDATION_MODE=auto
